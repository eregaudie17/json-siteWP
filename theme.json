{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"gradients": [
				{
					"gradient": "linear-gradient(0deg,rgb(255,255,255) 0%,rgb(255,255,255) 50%,rgba(0,0,0,0) 100%)",
					"name": "Light Overlay",
					"slug": "light-overlay"
				}
			],
			"palette": [
				{
					"color": "#17181A",
					"name": "Black",
					"slug": "black"
				},
				{
					"color": "#7F8082",
					"name": "Grey",
					"slug": "grey"
				},
				{
					"color": "#F5F1EE",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#2D114B",
					"name": "Dark-Blue",
					"slug": "dark-blue"
				},
				{
					"color": "#572192",
					"name": "Blue",
					"slug": "blue"
				},
				{
					"color": "#8A3CDD",
					"name": "Light-Blue",
					"slug": "light-blue"
				},
				{
					"color": "#864B1E",
					"name": "Accent-dark",
					"slug": "accent-dark"
				},
				{
					"color": "#BD672E",
					"name": "Accent",
					"slug": "Accent"
				},
				{
					"color": "#DAD3C0",
					"name": "Accent-light",
					"slug": "accent-light"
				}
			]
		},
		"layout": {
			"contentSize": "620px",
			"wideSize": "1366px"
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": "http://espaceporcelaine.com/wp-content/uploads/fonts/Montserrat-VariableFont_wght.ttf"
						}
					],
					"fontFamily": "Montserrat",
					"name": "Montserrat",
					"slug": "montserrat"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Cabin",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"src": "http://espaceporcelaine.com/wp-content/uploads/fonts/Cabin-VariableFont_wdthwght.ttf"
						}
					],
					"fontFamily": "Cabin",
					"name": "Cabin",
					"slug": "cabin"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/buttons": {
				"border": {
					"bottom": {
						"style": "none",
						"width": "0px"
					},
					"left": {
						"style": "none",
						"width": "0px"
					},
					"radius": {
						"bottomLeft": "0px",
						"bottomRight": "0px",
						"topLeft": "0px",
						"topRight": "0px"
					},
					"right": {
						"style": "none",
						"width": "0px"
					},
					"top": {
						"style": "none",
						"width": "0px"
					}
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--black)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--dark-blue)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cabin)",
					"fontSize": "20px",
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--grey)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--black)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cabin)",
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--Accent)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--accent-dark)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal",
					"fontWeight": "300"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontStyle": "normal",
			"fontWeight": "400"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "En-tête"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Pied de page"
		}
	],
	"version": 3
}